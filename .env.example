# Telegram Bot API Token (from @BotFather)
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Telegram Numeric User ID of the Main Administrator (e.g. from @userinfobot)
ADMIN_ID=123456789

# Download directory name (defaults to 'downloads' inside the project folder)
DOWNLOAD_DIR=downloads

# Optional: route downloads through a Proxy or V2Ray config on restricted servers (e.g. Russia, Iran)
# Supports: vless://, vmess://, trojan://, ss://, socks5://, or http://
# Leave empty for 100% direct connection (default)
# PROXY=vless://...
