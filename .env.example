# Telegram Bot API Token (from @BotFather)
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Telegram Numeric User ID of the Main Administrator (e.g. from @userinfobot)
ADMIN_ID=123456789

# Download directory name (defaults to 'downloads' inside the project folder)
DOWNLOAD_DIR=downloads

# (Optional) Outbound Proxy for regions where Telegram MTProto is restricted (Russia, Iran, etc.)
# Supports SOCKS5, SOCKS4, and HTTP proxies:
# PROXY_URL=socks5://127.0.0.1:10808
# PROXY_URL=socks5://username:password@1.2.3.4:1080
# PROXY_URL=http://127.0.0.1:8080
